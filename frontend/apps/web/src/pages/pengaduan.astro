---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.jsx";
import Footer from "../components/Footer.jsx";
import PengaduanForm from "../components/PengaduanForm.jsx";
---
<Layout>
  <Navbar client:load />
  <main style={{ minHeight: "100vh", display: "flex", flexDirection: "column", backgroundColor: "var(--background-color)" }}>
    <div style={{ flex: 1, padding: "120px 2rem 4rem", maxWidth: "800px", margin: "0 auto", width: "100%" }}>
      <div style={{ textAlign: "center", marginBottom: "2rem" }}>
        <div style={{ fontSize: "4rem", marginBottom: "0.5rem" }}>&#128225;</div>
        <h1 style={{ fontSize: "2.5rem", color: "var(--primary-color)", fontWeight: 800, marginBottom: "1rem" }}>Layanan Pengaduan</h1>
        <p style={{ color: "var(--text-light)", fontSize: "1.2rem", maxWidth: "620px", margin: "0 auto" }}>
          Saluran resmi untuk menyampaikan pengaduan, aspirasi, dan keluhan masyarakat atas pelayanan Kemenag Barito Utara.
        </p>
      </div>
      <PengaduanForm client:load />
    </div>
  </main>
  <Footer client:load />
</Layout>