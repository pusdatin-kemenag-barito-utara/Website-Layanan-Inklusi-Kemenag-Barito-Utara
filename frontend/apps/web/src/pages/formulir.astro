---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.jsx";
import Footer from "../components/Footer.jsx";
import FormulirPendataan from "../components/FormulirPendataan.jsx";
---
<Layout>
  <Navbar client:load />
  <main style={{ minHeight: "100vh", display: "flex", flexDirection: "column", backgroundColor: "var(--background-color)" }}>
    <div style={{ flex: 1, padding: "120px 2rem 4rem", maxWidth: "800px", margin: "0 auto", width: "100%" }}>
      <div style={{ textAlign: "center", marginBottom: "2rem" }}>
        <div style={{ fontSize: "4rem", marginBottom: "0.5rem" }}>&#128221;</div>
        <h1 style={{ fontSize: "2.5rem", color: "var(--primary-color)", fontWeight: 800, marginBottom: "1rem" }}>Formulir Pendataan Kelompok Rentan</h1>
        <p style={{ color: "var(--text-light)", fontSize: "1.2rem", maxWidth: "620px", margin: "0 auto" }}>
          Mohon isi data di bawah ini untuk mempermudah kami dalam memberikan pelayanan prioritas kepada Anda.
        </p>
      </div>

      <div style={{ display: "flex", justifyContent: "center", marginBottom: "2rem" }}>
        <a href="https://wa.me/6285117491212?text=Halo%20Admin%20PTSP,%20saya%20butuh%20bantuan%20untuk%20mengisi%20formulir%20inklusi" target="_blank" rel="noopener noreferrer" style={{ display: "inline-flex", alignItems: "center", gap: "8px", backgroundColor: "#e6f6ee", color: "var(--primary-color)", padding: "12px 24px", borderRadius: "30px", fontWeight: 600, textDecoration: "none", border: "1px solid var(--primary-color)", boxShadow: "0 4px 6px rgba(0,0,0,0.05)" }}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Butuh Bantuan Mengisi? Hubungi Admin
        </a>
      </div>

      <FormulirPendataan client:load />
    </div>
  </main>
  <Footer client:load />
</Layout>