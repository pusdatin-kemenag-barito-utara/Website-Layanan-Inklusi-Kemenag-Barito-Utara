---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.jsx";
import Footer from "../../components/Footer.jsx";
import TrackingForm from "../../components/TrackingForm.jsx";
---
<Layout>
  <Navbar client:load />
  <main style={{ minHeight: "100vh", display: "flex", flexDirection: "column", backgroundColor: "var(--background-color)" }}>
    <div style={{ flex: 1, padding: "120px 2rem 4rem", maxWidth: "800px", margin: "0 auto", width: "100%" }}>
      <div style={{ textAlign: "center", marginBottom: "2.5rem" }}>
        <div style={{ fontSize: "4rem", marginBottom: "0.5rem" }}>&#128269;</div>
        <h1 style={{ fontSize: "2.5rem", color: "var(--primary-color)", fontWeight: 800, marginBottom: "1rem" }}>Pelacakan Berkas</h1>
        <p style={{ color: "var(--text-light)", fontSize: "1.2rem", maxWidth: "620px", margin: "0 auto" }}>
          Pantau status proses pelayanan berkas Anda secara mandiri menggunakan nomor tanda terima (resi).
        </p>
      </div>
      <TrackingForm client:load />
    </div>
  </main>
  <Footer client:load />
</Layout>