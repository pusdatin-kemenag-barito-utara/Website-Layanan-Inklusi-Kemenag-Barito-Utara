---
import Layout from "../layouts/Layout.astro";
import "../styles/maintenance.css";

export const prerender = false;
---

<Layout>
  <div class="maintenance-root">
    <!-- Ambient glowing backdrop orbs matching Pusdatin design -->
    <div class="glow-orb glow-emerald"></div>
    <div class="glow-orb glow-blue"></div>

    <div class="maintenance-container">
      <!-- Official Pusdatin Header Badge -->
      <div class="pusdatin-header-badge">
        <img src="/favicon.svg" alt="Logo Kemenag" class="pusdatin-badge-logo" />
        <div class="pusdatin-badge-text">
          <span class="badge-title">PUSDATIN</span>
          <span class="badge-sub">Kemenag Barito Utara</span>
        </div>
      </div>

      <!-- Icon Unit: Gear Settings (Emerald) + Wrench (Blue Badge) -->
      <div class="icon-wrapper">
        <div class="icon-card">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="48"
            height="48"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#059669"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="gear-icon"
          >
            <path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          <div class="wrench-badge">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#ffffff"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- Main Heading (Pusdatin Style) -->
      <h1 class="main-title">Sistem Sedang Pemeliharaan</h1>

      <!-- Description Body -->
      <p class="main-desc">
        Aplikasi <strong>Pusat Layanan Inklusi</strong> saat ini sedang dalam mode perbaikan terpusat oleh Tim Pusdatin Kemenag Barito Utara. Kami sedang melakukan peningkatan sistem untuk memberikan pengalaman yang lebih baik.
      </p>

      <!-- Status Pills (Amber & Emerald) -->
      <div class="pills-row">
        <div class="status-pill pill-amber">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
            <path d="M12 9v4"></path>
            <path d="M12 17h.01"></path>
          </svg>
          <span>Akses Sementara Ditutup</span>
        </div>
        <div class="status-pill pill-emerald">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 6v6l4 2"></path>
          </svg>
          <span>Silakan periksa kembali nanti</span>
        </div>
      </div>

      <!-- Realtime Auto-Detection Notice -->
      <div class="realtime-status-box">
        <div class="pulse-indicator">
          <span class="pulse-ring"></span>
          <span class="pulse-dot"></span>
        </div>
        <span id="sync-text">Terhubung real-time ke Pusdatin — dialihkan otomatis begitu selesai.</span>
      </div>

      <!-- Quick Assistance Link for PTSP Inklusi -->
      <div class="emergency-contact">
        <p class="contact-note">
          Membutuhkan layanan mendesak bagi penyandang disabilitas atau kelompok rentan?
        </p>
        <div class="contact-actions">
          <a
            href="https://wa.me/6285117491212?text=Halo%20Admin%20PTSP%20Kemenag%20Barito%20Utara,%20saya%20membutuhkan%20informasi%20layanan%20inklusi"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>Hubungi Hotline PTSP (+62 851-1749-1212)</span>
          </a>
        </div>
      </div>

      <!-- Pusdatin Official Footer -->
      <div class="maintenance-footer">
        &copy; 2026 Pusdatin Kemenag Barito Utara
      </div>
    </div>
  </div>

  <!-- Client-side Realtime Watcher (SSE Stream + Periodic Backup) -->
  <script is:inline>
    (function initMaintenanceWatcher() {
      let isRedirecting = false;

      function checkOnline(status) {
        if (status === "online" && !isRedirecting) {
          isRedirecting = true;
          const syncText = document.getElementById("sync-text");
          if (syncText) {
            syncText.textContent = "Sistem sudah online! Mengalihkan ke beranda...";
            syncText.style.color = "#059669";
            syncText.style.fontWeight = "700";
          }
          setTimeout(() => {
            window.location.href = "/";
          }, 800);
        }
      }

      // 1. Connect to real-time Server-Sent Events stream
      if (typeof window !== "undefined" && "EventSource" in window) {
        try {
          const sse = new EventSource("/api/apps/status/events");
          sse.onmessage = function (event) {
            try {
              const data = JSON.parse(event.data);
              if (data && data.status) {
                checkOnline(data.status);
              }
            } catch (e) {}
          };
          sse.onerror = function () {};
        } catch (e) {}
      }

      // 2. Adaptive backup polling (checks in-memory status every 6 seconds)
      setInterval(async () => {
        if (isRedirecting) return;
        try {
          const res = await fetch("/api/apps/status", { cache: "no-store" });
          if (res.ok) {
            const json = await res.json();
            if (json && json.status) {
              checkOnline(json.status);
            }
          }
        } catch (e) {}
      }, 6000);
    })();
  </script>
</Layout>