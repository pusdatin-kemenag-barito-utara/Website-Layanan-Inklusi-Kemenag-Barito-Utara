---
import { Calendar, ArrowRight } from "lucide-react";
import type { Berita } from "../../lib/api";

interface Props {
  berita: Berita[];
}

const { berita } = Astro.props;

function formatDate(dateStr?: string) {
  if (!dateStr) return "";
  const date = new Date(dateStr);
  return new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "long", year: "numeric" }).format(date);
}
---

<section class="container" style={{ padding: "3rem 1rem 4rem" }}>
  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-end", flexWrap: "wrap", gap: "1rem", marginBottom: "2.5rem" }}>
    <div>
      <span class="section-badge">
        <Calendar size={16} />
        Kabar Terkini
      </span>
      <h2 class="section-title" style={{ textAlign: "left" }}>Berita & Kegiatan Inklusi</h2>
      <p style={{ color: "var(--text-light)", fontSize: "1rem", marginTop: "0.4rem" }}>
        Dokumentasi dan publikasi terkini program ramah disabilitas di lingkungan Kementerian Agama Barito Utara.
      </p>
    </div>
    <a href="/berita" style={{
      display: "inline-flex",
      alignItems: "center",
      gap: "8px",
      color: "var(--primary-color)",
      fontWeight: 700,
      fontSize: "0.95rem",
      padding: "8px 16px",
      borderRadius: "8px",
      backgroundColor: "rgba(11, 96, 86, 0.08)"
    }}>
      <span>Lihat Semua Berita</span>
      <ArrowRight size={16} />
    </a>
  </div>

  {berita.length > 0 ? (
    <div style={{
      display: "grid",
      gridTemplateColumns: "repeat(auto-fit, minmax(300px, 1fr))",
      gap: "1.75rem"
    }}>
      {berita.slice(0, 4).map((item) => (
        <a
          href={`/berita/${item.slug}`}
          class="modern-card"
          style={{
            textDecoration: "none",
            color: "inherit",
            display: "flex",
            flexDirection: "column",
            overflow: "hidden"
          }}
        >
          <div style={{ width: "100%", height: "190px", overflow: "hidden", backgroundColor: "#e2e8f0" }}>
            <img
              src={item.thumbnail || "/assets/branding/kemenag.svg"}
              alt={item.judul}
              style={{
                width: "100%",
                height: "100%",
                objectFit: "cover",
                transition: "transform 0.4s ease"
              }}
              loading="lazy"
            />
          </div>

          <div style={{ padding: "1.5rem", display: "flex", flexDirection: "column", flex: 1 }}>
            <div style={{ display: "flex", alignItems: "center", gap: "6px", color: "var(--secondary-dark)", fontSize: "0.825rem", fontWeight: 700, marginBottom: "0.5rem" }}>
              <Calendar size={14} />
              <span>{formatDate(item.tanggal)}</span>
            </div>

            <h3 style={{
              fontSize: "1.1rem",
              color: "#111827",
              fontWeight: 700,
              marginBottom: "0.75rem",
              lineHeight: 1.4,
              display: "-webkit-box",
              WebkitLineClamp: 2,
              WebkitBoxOrient: "vertical",
              overflow: "hidden"
            }}>
              {item.judul}
            </h3>

            {item.konten && (
              <p style={{
                fontSize: "0.875rem",
                color: "#64748b",
                lineHeight: 1.6,
                marginBottom: "1.25rem",
                display: "-webkit-box",
                WebkitLineClamp: 3,
                WebkitBoxOrient: "vertical",
                overflow: "hidden"
              }}>
                {item.konten}
              </p>
            )}

            <div style={{ marginTop: "auto", display: "flex", alignItems: "center", gap: "6px", color: "var(--primary-color)", fontWeight: 700, fontSize: "0.875rem" }}>
              <span>Baca Selengkapnya</span>
              <ArrowRight size={15} />
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="modern-card" style={{ textAlign: "center", padding: "3rem", color: "#64748b" }}>
      <p>Belum ada data berita yang dipublikasikan.</p>
    </div>
  )}
</section>
