---
import { FileText, ArrowRight, Download } from "lucide-react";
import type { Dokumen } from "../../lib/api";

interface Props {
  dokumen: Dokumen[];
}

const { dokumen } = Astro.props;
---

<section class="container" style={{ padding: "1rem 1rem 5rem" }}>
  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-end", flexWrap: "wrap", gap: "1rem", marginBottom: "2.5rem" }}>
    <div>
      <span class="section-badge">
        <FileText size={16} />
        Transparansi & Regulasi
      </span>
      <h2 class="section-title" style={{ textAlign: "left" }}>Dokumen & Panduan Layanan</h2>
      <p style={{ color: "var(--text-light)", fontSize: "1rem", marginTop: "0.4rem" }}>
        Unduh Standar Operasional Prosedur (SOP), buku panduan, dan formulir resmi layanan inklusi.
      </p>
    </div>
    <a href="/standar-layanan" style={{
      display: "inline-flex",
      alignItems: "center",
      gap: "8px",
      color: "var(--primary-color)",
      fontWeight: 700,
      fontSize: "0.95rem",
      padding: "8px 16px",
      borderRadius: "8px",
      backgroundColor: "rgba(11, 96, 86, 0.08)"
    }}>
      <span>Semua Dokumen</span>
      <ArrowRight size={16} />
    </a>
  </div>

  {dokumen.length > 0 ? (
    <div style={{
      display: "grid",
      gridTemplateColumns: "repeat(auto-fit, minmax(280px, 1fr))",
      gap: "1.5rem"
    }}>
      {dokumen.slice(0, 4).map((doc) => (
        <div class="modern-card" style={{ padding: "1.75rem", display: "flex", flexDirection: "column" }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "1rem" }}>
            <div style={{ width: "40px", height: "40px", borderRadius: "10px", backgroundColor: "rgba(11, 96, 86, 0.08)", display: "flex", alignItems: "center", justifyContent: "center" }}>
              <FileText size={20} style={{ color: "var(--primary-color)" }} />
            </div>
            {doc.jenis && (
              <span style={{
                fontSize: "0.75rem",
                fontWeight: 700,
                padding: "4px 10px",
                borderRadius: "6px",
                backgroundColor: "#f1f5f9",
                color: "#475569"
              }}>
                {doc.jenis}
              </span>
            )}
          </div>

          <h3 style={{
            fontSize: "1.05rem",
            fontWeight: 700,
            color: "#111827",
            marginBottom: "0.5rem",
            lineHeight: 1.4
          }}>
            {doc.judul}
          </h3>

          <div style={{ marginTop: "auto", paddingTop: "1.25rem" }}>
            <a
              href={doc.url_file || "#"}
              target="_blank"
              rel="noreferrer"
              style={{
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: "8px",
                backgroundColor: "var(--secondary-color)",
                color: "#111827",
                fontWeight: 700,
                fontSize: "0.875rem",
                padding: "10px 18px",
                borderRadius: "8px",
                textDecoration: "none",
                width: "100%",
                transition: "all 0.2s ease"
              }}
            >
              <Download size={16} />
              <span>Unduh Dokumen</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="modern-card" style={{ textAlign: "center", padding: "3rem", color: "#64748b" }}>
      <p>Belum ada dokumen standar pelayanan.</p>
    </div>
  )}
</section>
